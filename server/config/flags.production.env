# Production feature flags. Merging a change here to main ships it: CD builds a
# new API image and recreates the containers (no SSH, no api.env edit).
# A key here overrides the same key in /srv/hanbok/api.env; anything not listed
# keeps its api.env value. NEVER put secrets here (this repo is public).
# See server/lib/flags.js.

# Trials. Card-required trial (#187) replaces the no-card trial.
AUTO_TRIAL_ENABLED=false
RETURNING_TRIAL_ENABLED=false
TRIAL_STARTS_AT_FIRST_BREAKDOWN=true

# Analysis
STREAM_ANALYSIS=true

# Signed-out visitors get this many breakdowns a week before the sign-up wall.
ANON_WEEKLY_SENTENCES=3
